name: Daily Market Scanner

on:
  schedule:
    - cron: "30 10 * * 1-5"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: daily-market-scanner
  cancel-in-progress: false

jobs:
  update-rankings:
    runs-on: ubuntu-latest
    timeout-minutes: 90

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Install scanner dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pandas numpy yfinance

      - name: Run daily scanner
        run: python scanner_daily.py

      - name: Commit ranking files
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add top50_swing.csv top50_dividendos.csv top50_hibridas.csv scanner_status.json
          if git diff --cached --quiet; then
            echo "No ranking changes to commit."
          else
            git commit -m "Update daily market rankings"
            git push
          fi
